{
  "name": "flappy-kiro",
  "version": "1.0.0",
  "description": "A retro browser-based endless scroller game",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "test": "node node_modules/jest/bin/jest.js --coverage",
    "test:watch": "node node_modules/jest/bin/jest.js --watch",
    "test:unit": "node node_modules/jest/bin/jest.js test/unit",
    "test:integration": "node node_modules/jest/bin/jest.js test/integration",
    "test:fast-check": "node node_modules/jest/bin/jest.js test/unit/fast-check.test.js",
    "test:all": "npm test && npm run test:integration",
    "test:coverage": "npm test -- --coverageReporters=html && open coverage/lcov-report/index.html",
    "postinstall": "npm run test:unit -- --passWithNoTests 2>/dev/null || true"
  },
  "keywords": [
    "game",
    "browser",
    "canvas",
    "flappy-bird",
    "retro"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^8.1.3",
    "@babel/generator": "^8.1.3",
    "@babel/plugin-transform-runtime": "^8.1.2",
    "@babel/preset-env": "^8.0.7",
    "@types/jest": "^29.5.11",
    "babel-jest": "^30.5.2",
    "fast-check": "^3.15.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": [
      "<rootDir>/test/setup.js"
    ],
    "testMatch": [
      "**/test/**/*.test.js",
      "**/src/**/*.test.js"
    ],
    "moduleFileExtensions": [
      "js",
      "cjs",
      "mjs"
    ],
    "transform": {
      "^.+\\.js$": "babel-jest"
    },
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "verbose": true,
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/**/*.test.js",
      "!src/systems/Invincibility.js",
      "!src/**/Invincibility.js"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html",
      "json-summary"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 10,
        "functions": 10,
        "lines": 10,
        "statements": 10
      }
    },
    "testTimeout": 10000,
    "detectOpenHandles": true,
    "forceExit": true
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": ""
  },
  "bugs": {
    "url": ""
  }
}
